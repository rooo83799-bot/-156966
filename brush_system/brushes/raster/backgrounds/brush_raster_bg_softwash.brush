{
  "brush_id": "brush_raster_bg_softwash",
  "type": "raster",
  "category": "background",
  "layers": {
    "base": {
      "color": "$soft_white",
      "opacity": 1.0,
      "blend_mode": "normal"
    },
    "texture": {
      "pattern": "watercolor_grain",
      "opacity": 0.4,
      "scale": 1.5
